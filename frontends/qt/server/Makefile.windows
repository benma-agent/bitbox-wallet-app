include ../../../hardening.mk.inc
include ../../../env.mk.inc
include ../../../version.mk.inc
CGO=1
BUILDMODE=c-shared
GOARCH=amd64
GOOS=windows
GOTOOLCHAIN=local
BREEZ_LIB_DIR=../../../vendor/github.com/breez/breez-sdk-spark-go/breez_sdk_spark/lib/windows-amd64/
SERVER_OUT ?= .
SERVER_ARCHIVE_FLAGS := -trimpath -mod=vendor -ldflags="-s -w $(GO_RELEASE_LDFLAGS)" \
	-buildmode=c-archive

windows:
	CGO_CFLAGS="${GOWINSECFLAGS} ${CFLAGS}" \
	CGO_LDFLAGS="${GOWINLDFLAGS} ${LFLAGS}" \
	GOARCH=${GOARCH} CGO_ENABLED=${CGO} GOOS=${GOOS} GOTOOLCHAIN=${GOTOOLCHAIN} \
	bash ../../../scripts/go-trimpath.sh go build -trimpath -x -mod=vendor \
	-ldflags "$(GO_RELEASE_LDFLAGS)" \
	-buildmode="${BUILDMODE}" -o ${LIBNAME}.dll

windows-cross:
	CC=/usr/bin/x86_64-w64-mingw32-gcc \
	CC_FOR_TARGET=/usr/bin/x86_64-w64-mingw32-gcc \
	CGO_CFLAGS="-g ${GOWINSECFLAGS} ${CFLAGS}" \
	CGO_LDFLAGS="${GOWINLDFLAGS} ${LFLAGS}" \
	GOARCH=${GOARCH} CGO_ENABLED=${CGO} GOOS=${GOOS} GOTOOLCHAIN=${GOTOOLCHAIN} \
	bash ../../../scripts/go-trimpath.sh go build -trimpath -x -mod=vendor \
	-ldflags "$(GO_RELEASE_LDFLAGS)" \
	-buildmode="${BUILDMODE}" -o ${LIBNAME}.dll

windows-legacy:
ifdef BITBOX_QT_BUILD_DIR
# Recursive Make can enter this directory through the physical checkout path. Start Go at
# the release checkout and resolve the output first so Go and gcc use the same archive.
	CGO_ENABLED=1 bash ../../../scripts/go-trimpath.sh env MSYS2_ARG_CONV_EXCL='*' \
		go -C B:/src build $(SERVER_ARCHIVE_FLAGS) \
		-o "$$(cygpath -am "$(SERVER_OUT)/libserver.a")" ./frontends/qt/server
else
	CGO_ENABLED=1 bash ../../../scripts/go-trimpath.sh go build $(SERVER_ARCHIVE_FLAGS) \
		-o "$(SERVER_OUT)/libserver.a"
endif
	gcc server.def "$(SERVER_OUT)/libserver.a" -shared -lwinmm -lhid -lsetupapi -lWs2_32 \
		-L${BREEZ_LIB_DIR} -lbreez_sdk_spark_bindings \
		-o "$(SERVER_OUT)/libserver.dll" -Wl,--strip-debug,--no-insert-timestamp,--out-implib,"$(SERVER_OUT)/libserver.lib"

clean:
	-rm -f ${LIBNAME}.dll
	-rm -f ${LIBNAME}.h
	-rm -f ${LIBNAME}.a
	-rm -f ${LIBNAME}.lib
